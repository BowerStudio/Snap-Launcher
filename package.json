{
	"name": "snap-launcher",
	"version": "1.2.0",
	"private": true,
	"type": "module",
	"description": "Stream Deck plugin: launch apps and snap their windows to saved positions across monitors.",
	"scripts": {
		"test": "node --import ./tests/ts-resolve.mjs --test tests/**/*.test.ts",
		"build": "rollup -c",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.bowerstudio.snap-launcher\"",
		"version": "node bump-version.mjs",
		"set-version": "node bump-version.mjs"
	},
	"dependencies": {
		"@elgato/streamdeck": "^2.1.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-commonjs": "^28.0.0",
		"@rollup/plugin-node-resolve": "^16.0.0",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@types/node": "^24.0.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.8.0",
		"prettier": "^3.9.6",
		"rollup": "^4.28.0",
		"tslib": "^2.8.0",
		"typescript": "^5.7.0",
		"typescript-eslint": "^8.65.0"
	}
}
